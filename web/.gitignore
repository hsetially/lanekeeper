# Build and test output. The root .gitignore ignores web/dist and node_modules.
dist-perf/
# A build made on the side for a test run (LK_E2E_DIST, LK_DIST): `vite build --outDir dist-<name>`.
/dist-*/
# The list of modules of each chunk, written by the build for the bundle gate (scripts/perf/check-bundle.mjs).
.build-report/
test-results/
playwright-report/
# References rendered from the design handoff for the visual tests (T4); a committed manifest.json beside them records the inputs.
e2e/visual/.refs/
*.tsbuildinfo
# The visual specs' baselines (the app against itself) are generated in CI and reviewed as an artifact; no PNG of a run is a source file.
# Playwright's own default folder (`<spec>.ts-snapshots`) is ignored too, in case a run is made with another config.
e2e/visual/__baselines__/
e2e/**/*-snapshots/

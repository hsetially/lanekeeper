{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lanekeeper-hub values",
  "description": "Helm checks the values against this before rendering. Unknown keys are refused, so a typo cannot silently turn a setting off.",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "serviceAccount", "network"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]*$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "A tag is never deployed (S19)." }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "gcpServiceAccount"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "gcpServiceAccount": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trustedProxyHops": { "type": "integer", "minimum": 0, "maximum": 8 },
        "otlpEndpoint": { "type": "string", "pattern": "^(https?://[^\\s]+)?$" },
        "gcpProject": { "type": "string", "pattern": "^([A-Za-z0-9-]{1,63})?$", "description": "The Google project of the secrets and keys (LK_GCP_PROJECT). Required: the template says so by name." },
        "entra": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tenantId": { "type": "string", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$", "description": "The Entra tenant (LK_ENTRA_TENANT_ID), a GUID. Required." },
            "clientId": { "type": "string", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$", "description": "The app registration (LK_ENTRA_CLIENT_ID), a GUID. Required." }
          }
        },
        "kms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agentCa": { "type": "string", "pattern": "^(projects/[A-Za-z0-9_-]{1,63}/locations/[A-Za-z0-9_-]{1,63}/keyRings/[A-Za-z0-9_-]{1,63}/cryptoKeys/[A-Za-z0-9_-]{1,63}/cryptoKeyVersions/[0-9]{1,19})?$", "description": "A Cloud KMS key version (LK_AGENT_CA_KMS_REF). Required." },
            "replicaCa": { "type": "string", "pattern": "^(projects/[A-Za-z0-9_-]{1,63}/locations/[A-Za-z0-9_-]{1,63}/keyRings/[A-Za-z0-9_-]{1,63}/cryptoKeys/[A-Za-z0-9_-]{1,63}/cryptoKeyVersions/[0-9]{1,19})?$", "description": "A Cloud KMS key version (LK_REPLICA_CA_KMS_REF), another key than agentCa. Required." },
            "auditCheckpoint": { "type": "string", "pattern": "^(projects/[A-Za-z0-9_-]{1,63}/locations/[A-Za-z0-9_-]{1,63}/keyRings/[A-Za-z0-9_-]{1,63}/cryptoKeys/[A-Za-z0-9_-]{1,63}/cryptoKeyVersions/[0-9]{1,19})?$", "description": "A Cloud KMS key version (LK_AUDIT_CHECKPOINT_KMS_REF). Required." },
            "vault": { "type": "string", "pattern": "^(projects/[A-Za-z0-9_-]{1,63}/locations/[A-Za-z0-9_-]{1,63}/keyRings/[A-Za-z0-9_-]{1,63}/cryptoKeys/[A-Za-z0-9_-]{1,63})?$", "description": "A Cloud KMS crypto key WITHOUT a version (LK_VAULT_KMS_REF). Required." }
          }
        },
        "auditCheckpointBucket": { "type": "string", "pattern": "^([a-z0-9][a-z0-9._-]{1,61}[a-z0-9])?$", "description": "The Cloud Storage bucket with a retention lock (LK_AUDIT_CHECKPOINT_BUCKET). Required." },
        "agentEndpointHosts": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$" },
          "description": "The DNS names the agents reach the agent endpoint by (LK_AGENT_ENDPOINT_HOSTS): lower case, at most 8. Required."
        },
        "bootstrapAdmins": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
          "description": "Entra object ids that become active admins at their first sign-in (LK_BOOTSTRAP_ADMINS)."
        },
        "secretManager": {
          "type": "object",
          "additionalProperties": false,
          "description": "The NAMES of Secret Manager secrets. The chart creates none of them and the values are never secrets.",
          "properties": {
            "webCert": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$" },
            "webKey": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$" },
            "agentCaCert": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$" },
            "replicaCaCert": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$" },
            "entraClient": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$" },
            "loginCookie": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,255}$" }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseUrl": { "type": "string", "pattern": "^(https://[^\\s]+)?$" },
            "tenantUrl": { "type": "string", "pattern": "^(https://[^\\s]+)?$" },
            "baseRepo": { "type": "string", "pattern": "^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?$" },
            "tenantRepo": { "type": "string", "pattern": "^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?$" }
          }
        },
        "tuning": {
          "type": "object",
          "description": "The tunables of the hub (crates/hub/src/config.rs and config/*.rs) that a deployment may set, within the ranges the hub accepts. Every number is a JSON number in the hub's own range and never a string: the chart reads some of them (Sprig's int reads \"02000\" as octal and \"04096\" as nothing, and the hub reads 2000 and 4096), and a string is the one form the two read differently. Addresses, paths, files and secrets are the chart's, and so are the switches that turn on a write the design has not confirmed (LK_MCP_NOTIFY_SERVICES, LK_RETENTION_ENABLED, LK_RETENTION_DRY_RUN) and the settings that widen what the hub may reach or write (LK_EXTRA_DENY_GLOBS, LK_TEAMS_ALLOWED_HOSTS, LK_GITHUB_API_BASE, LK_ENTRA_AUTHORITY_HOST, LK_ENTRA_REDIRECT_PATH, LK_AUDIT_CHECKPOINT_VERIFY_KMS_REFS): none of them can be set from a values file.",
          "additionalProperties": false,
          "properties": {
            "LK_BLOB_CACHE_MIB": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "LK_BODY_MAX_BYTES": { "type": "integer", "minimum": 1024, "maximum": 67108864 },
            "LK_BUCKET_CAPACITY": { "type": "integer", "minimum": 100, "maximum": 10000000 },
            "LK_CONFIG_SERVER_DEPLOYMENT": { "type": "string", "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
            "LK_CORPUS_CACHE_MIB": { "type": "integer", "minimum": 16, "maximum": 4096 },
            "LK_DB_ACQUIRE_TIMEOUT_SECS": { "type": "integer", "minimum": 1, "maximum": 60 },
            "LK_DB_MAX_CONNECTIONS": { "type": "integer", "minimum": 1, "maximum": 512 },
            "LK_DB_STATEMENT_TIMEOUT_SECS": { "type": "integer", "minimum": 1, "maximum": 600 },
            "LK_ENTRA_API_AUDIENCES": { "type": "string", "maxLength": 512, "pattern": "^[A-Za-z0-9:/._@-]+(,[A-Za-z0-9:/._@-]+){0,7}$" },
            "LK_GIT_BASE_BRANCH": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*(\\.[A-Za-z0-9_-]+)*(/[A-Za-z0-9_][A-Za-z0-9_-]*(\\.[A-Za-z0-9_-]+)*)*$", "not": { "pattern": "\\.lock(/|$)" } },
            "LK_GIT_FETCH_TIMEOUT_SECS": { "type": "integer", "minimum": 5, "maximum": 1800 },
            "LK_GIT_QUEUE_CAPACITY": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "LK_IP_BURST": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "LK_IP_RATE_PER_SEC": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
            "LK_JSON_DEPTH": { "type": "integer", "minimum": 1, "maximum": 256 },
            "LK_MAX_CONNECTIONS": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "LK_MCP_AUTH": { "type": "string", "enum": ["oauth", "personal_token"] },
            "LK_MCP_CONFIRM": { "type": "string", "enum": ["elicitation", "draft"] },
            "LK_MCP_CONTENT": { "type": "string", "enum": ["summary", "data_block"] },
            "LK_REQUEST_TIMEOUT_SECS": { "type": "integer", "minimum": 1, "maximum": 600 },
            "LK_SHUTDOWN_DRAIN_SECS": { "type": "integer", "minimum": 1, "maximum": 120 },
            "LK_SHUTDOWN_GRACE_SECS": { "type": "integer", "minimum": 0, "maximum": 60 },
            "LK_START_TIMEOUT_SECS": { "type": "integer", "minimum": 1, "maximum": 120 },
            "LK_TREE_INDEX_ENTRIES": { "type": "integer", "minimum": 1000, "maximum": 50000000 },
            "LK_TRUSTED_TYPES": { "type": "string", "pattern": "^[A-Za-z0-9_.#=,-]*$" },
            "LK_USER_BURST": { "type": "integer", "minimum": 1, "maximum": 100000 },
            "LK_USER_RATE_PER_SEC": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
            "LK_WEB_CERT_RELOAD_SECS": { "type": "integer", "minimum": 1, "maximum": 86400 },
            "LK_WRITES_CLEANUP_SECS": { "type": "integer", "minimum": 60, "maximum": 604800 },
            "LK_WRITES_EXPIRE_SECS": { "type": "integer", "minimum": 1, "maximum": 86400 },
            "LK_WRITES_PR_JOBS_SECS": { "type": "integer", "minimum": 1, "maximum": 300 },
            "LK_WRITES_RECONCILE_SECS": { "type": "integer", "minimum": 1, "maximum": 3600 }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterName": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
        "credentialsSecretName": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
        "migratorSecretName": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
        "caSecretName": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*-db-ca)$" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": { "type": "string", "pattern": "^[0-9]+(Gi|Ti)$" },
        "cmekKey": { "type": "string", "pattern": "^(projects/[^/]+/locations/[^/]+/keyRings/[^/]+/cryptoKeys/[^/]+)?$" },
        "diskType": { "type": "string", "enum": ["pd-balanced", "pd-ssd"] },
        "fallbackClassName": { "type": "string", "minLength": 1 }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"], "additionalProperties": false, "properties": { "cpu": { "type": ["string", "number"] }, "memory": { "type": "string" } } },
        "limits": { "type": "object", "required": ["cpu", "memory"], "additionalProperties": false, "properties": { "cpu": { "type": ["string", "number"] }, "memory": { "type": "string" } } }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": { "type": "object", "required": ["cpu", "memory"], "additionalProperties": false, "properties": { "cpu": { "type": ["string", "number"] }, "memory": { "type": "string" } } },
            "limits": { "type": "object", "required": ["cpu", "memory"], "additionalProperties": false, "properties": { "cpu": { "type": ["string", "number"] }, "memory": { "type": "string" } } }
          }
        }
      }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200, "description": "LK_MIGRATE_TIMEOUT_SECS: the longest the whole run may take." },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingConfigMap": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$", "maxLength": 253 },
        "content": { "type": "string", "maxLength": 262144, "description": "The seed file, YAML, at most 256 KiB (the hub refuses more)." },
        "revision": { "type": "integer", "minimum": 1, "maximum": 1000000000, "description": "A counter that only moves forward: the Job's name is a hash of it, an old Job is kept (Prune=false), and a revision that is used again names a Job that has already run, so nothing runs. A revert is a new revision with the old file. With existingConfigMap the ConfigMap's name ends with it." },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600, "description": "LK_SEED_TIMEOUT_SECS: the longest the whole run may take." },
        "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "mode": { "type": "string", "enum": ["zone", "kind"] } }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentSourceRanges"],
      "properties": {
        "googleRanges": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" } },
        "agentSourceRanges": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$" }, "description": "Required and never empty: an empty allowlist is an open port (S18, Q1)." },
        "monitoringNamespace": { "type": "string", "minLength": 1 },
        "fqdnPolicy": { "type": "boolean" },
        "teamsWebhookHost": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$" }
      }
    },
    "agentLoadBalancer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ipAddress": { "type": "string", "pattern": "^([0-9.]+)?$" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$" },
        "addressName": { "type": "string", "pattern": "^([a-z]([a-z0-9-]*[a-z0-9])?)?$" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preSharedCerts": { "type": "string", "pattern": "^([a-z0-9,-]*)$" },
            "certManagerCerts": { "type": "string", "pattern": "^([a-z0-9,/._-]*)$" }
          }
        },
        "securityPolicyName": { "type": "string", "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$" },
        "timeoutSec": { "type": "integer", "minimum": 30, "maximum": 86400 }
      }
    }
  }
}

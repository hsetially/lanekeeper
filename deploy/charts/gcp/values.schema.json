{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lanekeeper-gcp values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "cloudArmor"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
    },
    "cloudArmor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "policyName": {
          "type": "string",
          "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "usersRanges": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$"
          }
        },
        "githubHookRanges": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        }
      }
    },
    "projectNumber": {
      "type": "string",
      "pattern": "^$|^[0-9]{6,20}$"
    },
    "environment": {
      "type": "string",
      "enum": [
        "",
        "staging",
        "prod"
      ]
    },
    "location": {
      "type": "string",
      "pattern": "^$|^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "workloadIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "hubServiceAccount": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "dbServiceAccount": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        }
      }
    },
    "buckets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^$|^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"
            },
            "cmekKey": {
              "type": "string",
              "pattern": "^$|^projects/[^/]+/locations/[^/]+/keyRings/[^/]+/cryptoKeys/[^/]+$"
            }
          }
        },
        "auditCheckpoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^$|^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"
            },
            "cmekKey": {
              "type": "string",
              "pattern": "^$|^projects/[^/]+/locations/[^/]+/keyRings/[^/]+/cryptoKeys/[^/]+$"
            },
            "retentionPeriodSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "isLocked": {
              "type": "boolean"
            }
          }
        },
        "docs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^$|^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$"
            },
            "cmekKey": {
              "type": "string",
              "pattern": "^$|^projects/[^/]+/locations/[^/]+/keyRings/[^/]+/cryptoKeys/[^/]+$"
            }
          }
        }
      }
    },
    "cmek": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diskKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^projects/[^/]+/locations/[^/]+/keyRings/[^/]+/cryptoKeys/[^/]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "binaryAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enforcementMode": {
          "type": "string",
          "enum": [
            "DRYRUN_AUDIT_LOG_ONLY",
            "ENFORCED_BLOCK_AND_AUDIT_LOG"
          ]
        },
        "attestorName": {
          "type": "string",
          "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "publicKeys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "keyVersion",
              "signatureAlgorithm",
              "publicKeyPem"
            ],
            "properties": {
              "keyVersion": {
                "type": "string",
                "pattern": "^projects/[^/]+/locations/[^/]+/keyRings/[^/]+/cryptoKeys/[^/]+/cryptoKeyVersions/[0-9]+$"
              },
              "signatureAlgorithm": {
                "type": "string",
                "enum": [
                  "ECDSA_P256_SHA256",
                  "EC_SIGN_P256_SHA256",
                  "ECDSA_P384_SHA384",
                  "EC_SIGN_P384_SHA384",
                  "RSA_PSS_3072_SHA256",
                  "RSA_PSS_4096_SHA256",
                  "RSA_PSS_4096_SHA512",
                  "RSA_SIGN_PKCS1_3072_SHA256",
                  "RSA_SIGN_PKCS1_4096_SHA256",
                  "RSA_SIGN_PKCS1_4096_SHA512"
                ]
              },
              "publicKeyPem": {
                "type": "string",
                "pattern": "^-----BEGIN PUBLIC KEY-----[\\s\\S]+-----END PUBLIC KEY-----\\s*$"
              }
            }
          }
        },
        "admissionWhitelistPatterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]+)?/[A-Za-z0-9._/-]*\\*?$"
          }
        }
      }
    }
  }
}

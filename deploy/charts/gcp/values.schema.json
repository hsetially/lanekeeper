{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lanekeeper-gcp values",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "cloudArmor"],
  "properties": {
    "project": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$" },
    "cloudArmor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "policyName": { "type": "string", "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$" },
        "usersRanges": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+(/[0-9]{1,3})?$" } },
        "githubHookRanges": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" } }
      }
    }
  }
}

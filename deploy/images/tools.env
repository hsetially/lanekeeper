# The supply-chain tools the image scripts run (09/T1; S19, S20). Each is a container image pinned by digest, at least 14
# days old when chosen (tag pushed 2026-10-06), so the scripts need Docker and nothing else installed. Renovate proposes new
# digests. Read with `. deploy/images/tools.env`; the Justfile recipes and CI use the same file.
#
#   docker buildx imagetools inspect docker.io/anchore/syft:v1.54.1   # Digest: of the multi-architecture index
LK_SYFT_IMAGE=docker.io/anchore/syft:v1.54.1@sha256:3eb5379ba7b409c3f4069b686110527af0c47df993fa5c10d13e7cf34f49b1aa
LK_GRYPE_IMAGE=docker.io/anchore/grype:v0.120.1@sha256:e4a44ef45d285b829ce6efe2642980329661bd2d18eab5fc539138d4adaebbbe
LK_CONFTEST_IMAGE=docker.io/openpolicyagent/conftest:v0.71.1@sha256:0e77cdf7c1fcde035f3c579e4aaa6664ee2a8be5777eaa9af9f520cdd02280c0
# cargo-cyclonedx 0.5.9 (2026-03-19, crates.io) lists the Rust crates compiled into each binary, which an image scanner
# cannot see in a stripped binary: `cargo install --locked cargo-cyclonedx --version 0.5.9`.
LK_CARGO_CYCLONEDX_VERSION=0.5.9

# 09/T2 (S19, S20). Where images come from, and the BuildKit that builds them.
#
# Docker Hub limits anonymous pulls to 100 an hour per IP address, and GitHub-hosted runners share addresses, so a CI run can
# get "429 Too Many Requests" (T1 hit it from a shared address). A long-lived Docker Hub token would stop that but has to be
# stored, which S19 and S20 rule out, so CI pulls Docker Hub images through a mirror: the docker-hub-mirror action points the
# Docker daemon at LK_CI_DOCKER_HUB_MIRROR, and builder.sh gives BuildKit the same mirror (LK_DOCKER_HUB_MIRROR). A digest names
# the bytes, so the mirror is not trusted: other content under the same digest is refused, and when the mirror fails the pull goes
# to Docker Hub. The tools that run on the host (actionlint, zizmor, cosign, crane and the others) are not images: they are
# release files pinned by version and sha256 in the Justfile (plan 09 A22), so they need no registry at all.
LK_CI_DOCKER_HUB_MIRROR=mirror.gcr.io
# The BuildKit that builds the images (BuildKit v0.34.0, released 2026-10-07; the same version is inside the Docker 29.9.2 that
# the T1 measurements were made with). The layer encoding (tar headers, compression) is BuildKit's, so a digest is reproducible
# for one BuildKit version (REPRODUCIBILITY.md): builder.sh creates a builder from exactly this image and checks the version it
# reports. `docker buildx imagetools inspect docker.io/moby/buildkit:v0.34.0` gives the same index digest as mirror.gcr.io.
LK_BUILDKIT_IMAGE=docker.io/moby/buildkit:v0.34.0@sha256:b059f8d7226d0b326bc871af489a5dddf65e36af4d20d14251b072974d9ee87c

# A registry for the publishing test (tests/publish-test.sh), which pushes to it on localhost: distribution 3.0.0. It runs
# only in tests; nothing is published to it. `docker buildx imagetools inspect` gives the same index digest on docker.io and on
# mirror.gcr.io.
LK_REGISTRY_IMAGE=docker.io/library/registry:3.0.0@sha256:6c5666b861f3505b116bb9aa9b25175e71210414bd010d92035ff64018f9457e

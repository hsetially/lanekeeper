# The supply-chain tools the image scripts run (09/T1; S19, S20). Each is a container image pinned by digest, at least 14
# days old when chosen (tag pushed 2026-10-06), so the scripts need Docker and nothing else installed. Renovate proposes new
# digests. Read with `. deploy/images/tools.env`; the Justfile recipes and CI use the same file.
#
#   docker buildx imagetools inspect docker.io/anchore/syft:v1.54.1   # Digest: of the multi-architecture index
LK_SYFT_IMAGE=docker.io/anchore/syft:v1.54.1@sha256:3eb5379ba7b409c3f4069b686110527af0c47df993fa5c10d13e7cf34f49b1aa
LK_GRYPE_IMAGE=docker.io/anchore/grype:v0.120.1@sha256:e4a44ef45d285b829ce6efe2642980329661bd2d18eab5fc539138d4adaebbbe
LK_CONFTEST_IMAGE=docker.io/openpolicyagent/conftest:v0.71.1@sha256:0e77cdf7c1fcde035f3c579e4aaa6664ee2a8be5777eaa9af9f520cdd02280c0
# cargo-cyclonedx 0.5.9 (2026-03-19, crates.io) lists the Rust crates compiled into each binary, which an image scanner
# cannot see in a stripped binary: `cargo install --locked cargo-cyclonedx --version 0.5.9`.
LK_CARGO_CYCLONEDX_VERSION=0.5.9

# The settings of `just dev` that are not paths (plan 18, T8, G23): the hub's own LK_* variables, every one a name or a number for a
# laptop. Nothing here is a secret; the paths (the database URL file, its CA, the secrets directory, the mirror volume and the built
# web app) are added by the recipe, and the secrets are files in target/dev/secrets that the software edges of
# `examples/hub_dev.rs` read. Sourced by `just dev` with `set -a`.
LK_WEB_ADDR=127.0.0.1:8443
LK_OPS_ADDR=127.0.0.1:9090
LK_AGENT_ADDR=127.0.0.1:8444
LK_REPLICA_ADDR=127.0.0.1:8445
LK_TRUSTED_PROXY_HOPS=0
LK_WEB_CERT_REF=web-cert
LK_WEB_KEY_REF=web-key
LK_REPLICA_NAME=hub-dev-0
LK_REPLICA_ADDRESS=localhost:8445
LK_HUB_AUDIENCE=https://localhost:8443
LK_AGENT_ENDPOINT_HOSTS=localhost
LK_AGENT_CA_KMS_REF=projects/dev/locations/l/keyRings/r/cryptoKeys/agent-ca/cryptoKeyVersions/1
LK_AGENT_CA_CERT_REF=agent-ca-cert
LK_REPLICA_CA_KMS_REF=projects/dev/locations/l/keyRings/r/cryptoKeys/replica-ca/cryptoKeyVersions/1
LK_REPLICA_CA_CERT_REF=replica-ca-cert
LK_VAULT_KMS_REF=projects/dev/locations/l/keyRings/r/cryptoKeys/vault
LK_AUDIT_CHECKPOINT_BUCKET=dev-audit-checkpoints
LK_AUDIT_CHECKPOINT_KMS_REF=projects/dev/locations/l/keyRings/r/cryptoKeys/audit-checkpoint/cryptoKeyVersions/1
LK_PUBLIC_ORIGIN=https://localhost:8443
LK_ENTRA_TENANT_ID=11111111-1111-4111-8111-111111111111
LK_ENTRA_CLIENT_ID=22222222-2222-4222-8222-222222222222
LK_ENTRA_CLIENT_AUTH_REF=entra-client
LK_ENTRA_COOKIE_KEY_REF=login-cookie
# The Git remotes are the real names and are never reached: the mirrors are the generated fixtures, copied into the volume by the recipe.
LK_GIT_BASE_URL=https://github.com/dev-null/configuration-base-saas.git
LK_GIT_TENANT_URL=https://github.com/dev-null/csp-tenant-data.git
LK_GIT_BASE_REPO=dev-null/configuration-base-saas
LK_GIT_TENANT_REPO=dev-null/csp-tenant-data
LK_START_TIMEOUT_SECS=30
LK_SHUTDOWN_GRACE_SECS=1
LK_SHUTDOWN_DRAIN_SECS=5
# The development sign-in (examples/support/dev_login.rs): `http://localhost:8480/` signs a development administrator in and sends the
# browser to the hub. Loopback only. Remove the line to run the hub with no way in but Entra, which a laptop cannot reach.
LK_DEV_LOGIN_ADDR=127.0.0.1:8480
